use std.test {assert-eq assert-false assert-throws assert-true summarize test}
use std.collection :as collection
use std.list {map filter}

;; ── zip / zip-with / enumerate ───────────────────────

r1 := test "zip" (-> assert-eq #[#(1 :a) #(2 :b)] (collection.zip #[1 2 3] #[:a :b]))
r2 := test "zip-with" (-> assert-eq #[5 7 9] (collection.zip-with (+) #[1 2 3] #[4 5 6]))
r3 := test "enumerate" (-> assert-eq #[#(0 :a) #(1 :b) #(2 :c)] (collection.enumerate #[:a :b :c]))

;; ── flatten / distinct ───────────────────────────────

r4 := test "flatten" (-> assert-eq #[1 2 3 4] (collection.flatten #[#[1 2] #[3 4]]))
r5 := test "distinct" (-> assert-eq #[1 2 3] (collection.distinct #[1 2 1 3 2]))

;; ── frequencies ──────────────────────────────────────

r6 := test "frequencies" (-> assert-eq 3 (get ":a" (collection.frequencies #[:a :b :a :c :b :a])))

;; ── partition ────────────────────────────────────────

r7 := test "partition" (-> assert-eq #[#[1 2] #[3 4] #[5]] (collection.partition 2 #[1 2 3 4 5]))
r8 := test "partition exact" (-> assert-eq #[#[1 2] #[3 4]] (collection.partition 2 #[1 2 3 4]))

;; ── sort-by ──────────────────────────────────────────

r9 := test "sort-by" (-> assert-eq #["a" "bb" "ccc"] (collection.sort-by length #["ccc" "a" "bb"]))

;; Ties keep their order, and the elements themselves are never
;; compared: records have no order of their own.
r9a := test "sort-by is stable" (-> assert-eq #["b" "a" "cc"] (collection.sort-by length #["b" "cc" "a"]))
r9b := test "sort-by never compares elements" (-> assert-eq #[{k= 1 n= "x"} {k= 1 n= "y"}] (collection.sort-by (r -> r.k) #[{k= 1 n= "x"} {k= 1 n= "y"}]))

;; ── map-vals / filter-vals / map-keys ────────────────

m1 := {a= 1 b= 2}
m2 := {a= 1 b= 20 c= 3}
r10 := test "map-vals" (-> assert-eq 10 (get "a" (collection.map-vals (x -> x * 10) m1)))
r11 := test "filter-vals" (-> assert-eq 1 (length (keys (collection.filter-vals (x -> x > 5) m2))))
r12 := test "map-keys" (-> assert-eq 1 (get "A" (collection.map-keys upper-case m1)))

;; ── each ─────────────────────────────────────────────

r13 := test "each returns unit" (-> assert-eq () (collection.each (x -> x) #[]))

;; ── find-index ───────────────────────────────────────

r14 := test "find-index found" (-> assert-eq 2 (collection.find-index (x -> x > 5) #[1 3 7 9]))
r15 := test "find-index not found" (-> assert-eq (0 - 1) (collection.find-index (x -> x > 100) #[1 2 3]))

;; ── all? / any? / none? ─────────────────────────────

r16 := test "all? true" (-> assert-true (collection.all? (x -> x > 0) #[1 2 3]))
r17 := test "all? false" (-> assert-false (collection.all? (x -> x > 0) #[1 0 3]))
r18 := test "any? true" (-> assert-true (collection.any? (x -> x > 5) #[1 2 6]))
r19 := test "any? false" (-> assert-false (collection.any? (x -> x > 5) #[1 2 3]))
r20 := test "none? true" (-> assert-true (collection.none? (x -> x > 5) #[1 2 3]))
r21 := test "none? false" (-> assert-false (collection.none? (x -> x > 5) #[1 2 6]))

;; ── flat-map ─────────────────────────────────────────

r22 := test "flat-map" (-> assert-eq #[1 1 2 2 3 3] (collection.flat-map (x -> #[x x]) #[1 2 3]))

;; ── sum / product ────────────────────────────────────

r23 := test "sum" (-> assert-eq 10 (collection.sum #[1 2 3 4]))
r24 := test "product" (-> assert-eq 24 (collection.product #[1 2 3 4]))

;; ── count-by ─────────────────────────────────────────

r25 := test "count-by" (-> assert-eq 2 (collection.count-by (x -> x > 3) #[1 2 4 5]))

;; ── interleave ───────────────────────────────────────

r26 := test "interleave" (-> assert-eq #[1 :a 2 :b 3 :c] (collection.interleave #[1 2 3] #[:a :b :c]))

;; ── take-while ───────────────────────────────────────

r27 := test "take-while" (-> assert-eq #[1 2 3] (collection.take-while (x -> x < 4) #[1 2 3 5 6]))
r28 := test "take-while all" (-> assert-eq #[1 2 3] (collection.take-while (x -> x < 10) #[1 2 3]))

;; ── window ───────────────────────────────────────────

r29 := test "window" (-> assert-eq #[#[1 2] #[2 3] #[3 4]] (collection.window 2 #[1 2 3 4]))
r30 := test "window too big" (-> assert-eq #[] (collection.window 5 #[1 2 3]))

;; ── group-by ─────────────────────────────────────────

r31 := test "group-by" (-> assert-eq 2 (length (keys (collection.group-by (x -> x % 2) #[1 2 3 4 5]))))

;; ── seqOp multi-arg form: `@ f xs` without pipeline ─────

r32 := test "@ f xs maps directly"  (-> assert-eq #[1 4 9] (@ (x -> x * x) #[1 2 3]))
r33 := test "/? pred xs filters"    (-> assert-eq #[2 4]   (/? (x -> x % 2 == 0) #[1 2 3 4]))
r34 := test "/^ f xs reduces"       (-> assert-eq 6        (/^ (+) #[1 2 3]))
r35 := test "seqOp still curries"   (-> assert-eq #[1 4 9] (#[1 2 3] |> @ (x -> x * x)))

;; ── attribute-style map keys with colons (for HTML/DOM) ────

attr-map := {data-on:click= "alert('hi')" hx-on:htmx:after-request= "log()"}
r36 := test "attr ident key"      (-> assert-eq "alert('hi')" (get "data-on:click" attr-map))
r37 := test "nested attr ident"   (-> assert-eq "log()" (get "hx-on:htmx:after-request" attr-map))

;; ── else if chain ──────────────────────────────────────

fn classify :: Int Str
  n =>
    if n < 0
      "neg"
    else if n == 0
      "zero"
    else if n < 10
      "small"
    else
      "big"

r38 := test "else if: first"    (-> assert-eq "neg"   (classify (-1)))
r39 := test "else if: middle"   (-> assert-eq "zero"  (classify 0))
r40 := test "else if: chained"  (-> assert-eq "small" (classify 5))
r41 := test "else if: final"    (-> assert-eq "big"   (classify 100))

;; ── toml-parse ──────────────────────────────────────

toml-src := "[project]\nname = \"demo\"\nversion = \"1.2.3\"\n\n[deps]\nfoo = \"^0.1\"\n"
cfg := toml-parse toml-src
r42 := test "toml project.name"    (-> assert-eq "demo"  cfg.project.name)
r43 := test "toml project.version" (-> assert-eq "1.2.3" cfg.project.version)
r44 := test "toml deps.foo"        (-> assert-eq "^0.1"  cfg.deps.foo)

;; ── to-set / to-tuple ───────────────────────────────
;;
;; The dynamic-arity counterparts of the `#{}` and `#(...)` literals: the
;; way to build a Set or a Tuple whose size is known only at runtime.

r45 := test "to-set dedupes"        (-> assert-eq 3 (length (to-set #[1 2 3 2 1])))
r46 := test "to-set equals literal" (-> assert-true (to-set #[1 2 3] == #{1 2 3}))
r47 := test "to-set from range"     (-> assert-eq 3 (length (to-set (0 ..< 3))))
r48 := test "to-set of a map"       (-> assert-true (to-set {a= 1 b= 2} == #{1 2}))
r49 := test "to-tuple keeps order"  (-> assert-true (to-tuple #[1 2 3] == #(1 2 3)))
r50 := test "to-tuple round-trips"  (-> assert-eq #[1 2 3] (to-vec (to-tuple #[1 2 3])))
r51 := test "to-set rejects Int"    (-> assert-throws (-> to-set 42))

;; conj adds to a Set as it appends to a Vector.
r52 := test "conj adds to a Set"         (-> assert-eq #{1 2} (conj #{1} 2))
r53 := test "conj on a Set dedups"       (-> assert-eq #{1} (conj #{1} 1))
r54 := test "conj adds a record to a Set" (-> assert-true (contains? (conj #{} {gate= :policy}) {gate= :policy}))
r55 := test "conj rejects a Map"          (-> assert-throws (-> conj {} 1))

;; A Set is a collection like the others: `empty?` answers for it and
;; `fold` walks it (in no particular order, so fold it with an
;; operation that does not depend on one).
r56 := test "empty? on an empty Set"      (-> assert-true (empty? #{}))
r57 := test "empty? on a Set"             (-> assert-false (empty? #{1}))
r58 := test "fold sums a Set"             (-> assert-eq 6 (fold (+) 0 #{1 2 3}))
r59 := test "fold unions two Sets"        (-> assert-eq #{1 2 3} (fold (acc x -> conj acc x) #{1} #{2 3}))
r60 := test "map walks a Set"             (-> assert-eq #[2 4] (sort (map (x -> x * 2) #{1 2})))
r61 := test "filter walks a Set"          (-> assert-eq #[2] (filter (x -> x > 1) #{1 2}))

summarize #[r1 r2 r3 r4 r5 r6 r7 r8 r9 r9a r9b r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31 r32 r33 r34 r35 r36 r37 r38 r39 r40 r41 r42 r43 r44 r45 r46 r47 r48 r49 r50 r51 r52 r53 r54 r55 r56 r57 r58 r59 r60 r61]

;; ── take / drop bounds ───────────────────────────────

rtd1 := test "take negative is empty" (-> assert-eq #[] (take (-1) #[1 2]))
rtd2 := test "take past the end is all" (-> assert-eq #[1 2] (take 9 #[1 2]))
rtd3 := test "drop negative is all" (-> assert-eq #[1 2] (drop (-3) #[1 2]))
rtd4 := test "drop past the end is empty" (-> assert-eq #[] (drop 9 #[1 2]))
rtd5 := test "drop some" (-> assert-eq #[3 4] (drop 2 #[1 2 3 4]))
