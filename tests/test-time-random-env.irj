use std.test {assert-eq assert-throws assert-true test}
use std.time :as time
use std.time {Time}
use std.random :as random
use std.random {Random}
use std.env :as env
use std.env {Env}

;; ── std.time ──────────────────────────────────────────────

fn run-time-now ::: Time
  =>
  t := time-now ()
  assert-true (t > 0)

fn wrap-time-now ::: Time
  =>
  with time.default-time
    run-time-now ()

test "time-now returns positive" (-> wrap-time-now ())

fn run-time-sleep ::: Time
  =>
  start := time-now ()
  time-sleep 10
  elapsed := time-now () - start
  assert-true (elapsed >= 0)

fn wrap-time-sleep ::: Time
  =>
  with time.default-time
    run-time-sleep ()

test "time-sleep does not error" (-> wrap-time-sleep ())

handler fixed-clock :: Time
  time-now       => resume 1700000000000
  time-sleep ms  => resume ()

fn run-time-mock ::: Time
  =>
  t1 := time-now ()
  t2 := time-now ()
  assert-eq 1700000000000 t1
  assert-eq t1 t2

fn wrap-time-mock ::: Time
  =>
  with fixed-clock
    run-time-mock ()

test "Time handler is mockable" (-> wrap-time-mock ())

;; now-ms and sleep perform time-now and time-sleep: under a handler
;; they get its answers, so code calling them directly is mockable.
handler virtual-clock :: Time
  clock :! 1000
  time-now       => resume clock
  time-sleep ms  =>
    clock <- clock + ms
    resume ()

fn run-builtin-clock ::: Time
  =>
  start := now-ms ()
  sleep 5000
  assert-eq 5000 ((now-ms ()) - start)

fn wrap-builtin-clock ::: Time
  =>
  with virtual-clock
    run-builtin-clock ()

test "now-ms and sleep answer from the handler" (-> wrap-builtin-clock ())

handler no-wait :: Time
  time-sleep ms => resume ()

fn run-no-wait ::: Time
  =>
  t := now-ms ()
  assert-true (t > 1700000000000)
  sleep 5000
  assert-true (((now-ms ()) - t) < 4000)

fn wrap-no-wait ::: Time
  =>
  with no-wait
    run-no-wait ()

;; no-wait has no time-now clause: now-ms reads the real clock.
test "a Time handler answers the ops it has clauses for" (-> wrap-no-wait ())

;; default-time's clauses call the builtins they stand in for, which
;; reach the real clock rather than the clause again.
fn run-default-time-builtins ::: Time
  =>
  t := now-ms ()
  assert-true (t > 1700000000000)
  sleep 20
  assert-true (((now-ms ()) - t) >= 20)
  assert-true ((time-now ()) >= t)

fn wrap-default-time-builtins ::: Time
  =>
  with time.default-time
    run-default-time-builtins ()

test "default-time reads the real clock" (-> wrap-default-time-builtins ())

handler offset-clock :: Time ::: Time
  time-now => resume ((now-ms ()) + 5)

fn run-offset ::: Time
  =>
  assert-eq 1700000000005 (now-ms ())

fn wrap-offset ::: Time
  =>
  with fixed-clock
    with offset-clock
      run-offset ()

test "a clause's own now-ms goes to the next handler out" (-> wrap-offset ())

fn negative-sleep ::: Time
  (-> sleep (0 - 1))

fn float-sleep ::: Time
  (-> sleep 1.5)

fn str-sleep ::: Time
  (-> sleep "10")

fn run-bad-sleep ::: Time
  =>
  assert-throws negative-sleep
  assert-throws float-sleep
  assert-throws str-sleep

fn wrap-bad-sleep ::: Time
  =>
  with fixed-clock
    run-bad-sleep ()

;; Checked before the handler sees it. sleep "10" used to sleep 0 ms and
;; sleep 1.5 to sleep 1; a negative count leaked a Java exception.
test "sleep needs a non-negative Int, mocked or not" (-> wrap-bad-sleep ())

;; ── std.random ────────────────────────────────────────────

fn run-rand-int ::: Random
  =>
  n := rand-int 100
  assert-true (n >= 0)
  assert-true (n < 100)

fn wrap-rand-int ::: Random
  =>
  with random.default-random
    run-rand-int ()

test "rand-int stays in bound" (-> wrap-rand-int ())

fn run-rand-float ::: Random
  =>
  f := rand-float ()
  assert-true (f >= 0.0)
  assert-true (f < 1.0)

fn wrap-rand-float ::: Random
  =>
  with random.default-random
    run-rand-float ()

test "rand-float in [0,1)" (-> wrap-rand-float ())

handler fixed-random :: Random
  rand-int bound => resume 42
  rand-float     => resume 0.5

fn run-rand-mock ::: Random
  =>
  assert-eq 42 (rand-int 1000000)
  assert-eq 0.5 (rand-float ())

fn wrap-rand-mock ::: Random
  =>
  with fixed-random
    run-rand-mock ()

test "Random handler is mockable" (-> wrap-rand-mock ())

;; The builtins perform the effect too: under a handler they get its
;; answers, so code calling random-int directly is mockable.
fn run-builtin-mock ::: Random
  =>
  assert-eq 42 (random-int 6)
  assert-eq 0.5 (random-float ())

fn wrap-builtin-mock ::: Random
  =>
  with fixed-random
    run-builtin-mock ()

test "random-int and random-float answer from the handler" (-> wrap-builtin-mock ())

handler fixed-token :: Random
  rand-token n => resume ("tok" ++ (to-str n))

fn run-token-mock ::: Random
  =>
  assert-eq "tok16" (random-token 16)
  n := random-int 1000
  assert-true ((n >= 0) && (n < 1000))

fn wrap-token-mock ::: Random
  =>
  with fixed-token
    run-token-mock ()

;; fixed-token has no rand-int clause: random-int draws for real.
test "a handler answers the ops it has clauses for" (-> wrap-token-mock ())

;; default-random's clauses call the builtins they stand in for, which
;; reach the real source rather than the clause again.
fn run-default-builtins ::: Random
  =>
  n := random-int 10
  assert-true ((n >= 0) && (n < 10))
  assert-eq 43 (length (random-token 32))

fn wrap-default-builtins ::: Random
  =>
  with random.default-random
    run-default-builtins ()

test "default-random draws from the real source" (-> wrap-default-builtins ())

handler doubling :: Random ::: Random
  rand-int bound => resume (2 * (random-int bound))

fn run-nested ::: Random
  =>
  assert-eq 84 (random-int 6)

fn wrap-nested ::: Random
  =>
  with fixed-random
    with doubling
      run-nested ()

test "a clause's own random-int goes to the next handler out" (-> wrap-nested ())

fn zero-bound ::: Random
  (-> random-int 0)

fn float-bytes ::: Random
  (-> random-token 1.9)

fn run-bad-args ::: Random
  =>
  assert-throws zero-bound
  assert-throws float-bytes

fn wrap-bad-args ::: Random
  =>
  with random.default-random
    run-bad-args ()

;; A Float used to be truncated: random-token 1.9 made a 1-byte token.
test "random-int needs a positive Int, random-token an Int" (-> wrap-bad-args ())

;; ── std.env ───────────────────────────────────────────────

fn run-env-default ::: Env
  =>
  v := env-var "IRIJ_DOES_NOT_EXIST_XYZ" "fallback"
  assert-eq "fallback" v

fn wrap-env-default ::: Env
  =>
  with env.default-env
    run-env-default ()

test "env-var returns default when unset" (-> wrap-env-default ())

fn run-env-args-default ::: Env
  =>
  assert-eq #[] (env-args ())

fn wrap-env-args-default ::: Env
  =>
  with env.default-env
    run-env-args-default ()

test "env-args is empty when a test file runs" (-> wrap-env-args-default ())

handler mock-env :: Env
  env-var name default => resume ("mocked-" ++ name)
  env-args () => resume #["--ui" "cli"]

fn run-env-mock ::: Env
  =>
  assert-eq "mocked-HOME" (env-var "HOME" "")
  assert-eq "mocked-PATH" (env-var "PATH" "")
  assert-eq #["--ui" "cli"] (env-args ())

fn wrap-env-mock ::: Env
  =>
  with mock-env
    run-env-mock ()

test "Env handler is mockable" (-> wrap-env-mock ())
