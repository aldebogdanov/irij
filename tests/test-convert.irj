use std.test {assert-eq summarize test}
use std.convert :as convert

r1 := test "to-int from string" (-> assert-eq 42 (convert.to-int "42"))
r2 := test "to-float from string" (-> assert-eq 3.14 (convert.to-float "3.14"))
r3 := test "digits" (-> assert-eq #[1 2 3] (to-vec (convert.digits "123")))

summarize #[r1 r2 r3]
