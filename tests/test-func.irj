use std.test {assert-eq assert-true summarize test}
use std.func :as func

sub := (a b -> a - b)
double := (x -> x * 2)
inc := (x -> x + 1)
pos? := (x -> x > 0)

r1 := test "flip" (-> assert-eq (0 - 3) (func.flip sub 5 2))
r2 := test "compose" (-> assert-eq 7 (func.compose inc double 3))
r3 := test "pipe" (-> assert-eq 7 (func.pipe double inc 3))
r4 := test "apply-to" (-> assert-eq 10 (func.apply-to 5 double))
r5 := test "on" (-> assert-eq 13 (func.on (+) (x -> x * x) 2 3))
r6 := test "juxt" (-> assert-eq #(6 10) (func.juxt inc double 5))
r7 := test "complement" (-> assert-true ((func.complement pos?) (0 - 1)))
r8 := test "constantly" (-> assert-eq 42 (func.constantly 42 "anything"))

summarize #[r1 r2 r3 r4 r5 r6 r7 r8]
