;; ── std.log tests ──────────────────────────────────────────────────

use std.test {assert-eq summarize test}
use std.log :as log
use std.log {Log}

handler mem-log :: Log
  state :! #[]
  log-msg level msg =>
    state <- conj state (level ++ ":" ++ msg)
    resume ()

captured := with mem-log
  log.log-info "hello"
  log.log-warn "careful"
  log.log-error "boom"
  mem-log.state

r1 := test "levels route through log-msg" (-> assert-eq captured #["info:hello" "warn:careful" "error:boom"])

silent := with log.silent-log
  log.log-info "dropped"
  :done

r2 := test "silent-log drops output" (-> assert-eq silent :done)

fn do-work :: Int Int ::: Log
  n =>
    log.log-info "working on ${n}"
    n * 2

dl-result := with log.default-log
  do-work 5

r3 := test "default-log prints and resumes" (-> assert-eq dl-result 10)

summarize #[r1 r2 r3]
