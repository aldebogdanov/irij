use std.test {assert-eq assert-false assert-throws assert-true summarize test}
use std.text :as str

r1 := test "chars" (-> assert-eq #["h" "e" "l" "l" "o"] (str.chars "hello"))
r2 := test "words" (-> assert-eq #["hello" "world"] (str.words "hello world"))
r3 := test "lines" (-> assert-eq #["a" "b" "c"] (str.lines "a\nb\nc"))
r4 := test "unwords" (-> assert-eq "hello world" (str.unwords #["hello" "world"]))
r5 := test "unlines" (-> assert-eq "a\nb\nc" (str.unlines #["a" "b" "c"]))
r6 := test "blank? empty" (-> assert-true (str.blank? ""))
r7 := test "blank? spaces" (-> assert-true (str.blank? "   "))
r8 := test "blank? not" (-> assert-false (str.blank? "hi"))
r9 := test "contains-substr? true" (-> assert-true (str.contains-substr? "hello world" "world"))
r10 := test "contains-substr? false" (-> assert-false (str.contains-substr? "hello" "xyz"))
r11 := test "pad-left" (-> assert-eq "00042" (str.pad-left 5 "0" "42"))
r12 := test "pad-left no-op" (-> assert-eq "hello" (str.pad-left 3 "0" "hello"))
r13 := test "pad-right" (-> assert-eq "42000" (str.pad-right 5 "0" "42"))
r14 := test "repeat" (-> assert-eq "abcabcabc" (str.repeat 3 "abc"))
r15 := test "repeat zero" (-> assert-eq "" (str.repeat 0 "abc"))

;; Round-trip: words then unwords
r16 := test "words/unwords round-trip" (-> assert-eq "a b c" (str.unwords (str.words "a b c")))

summarize #[r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16]

;; ── code points and case ──────────────────────────────────

;; Splitting into characters keeps a non-BMP character (an emoji, two
;; UTF-16 chars) whole.
test "chars keeps an emoji whole" (-> assert-eq (str.chars "a😀b") #["a" "😀" "b"])

;; Case conversion is locale-independent (a Turkish default locale would
;; otherwise upper-case `i` to a dotted `İ`).
test "upper-case is locale-independent" (-> assert-eq (upper-case "title") "TITLE")
test "lower-case is locale-independent" (-> assert-eq (lower-case "TITLE") "title")

test "from-char-code round-trips an emoji" (-> assert-eq (from-char-code (char-code "😀")) "😀")

;; ── URL encoding ──────────────────────────────────────────
;;
;; url-encode / url-decode are the form encoding of a query string (a
;; space is `+`); percent-encode is RFC 3986's, for a path segment. None
;; substitutes for what has no exact encoding, so different strings never
;; encode or decode alike.

test "url-encode is form encoding" (-> assert-eq (url-encode "a b+c/é~") "a+b%2Bc%2F%C3%A9%7E")
test "url-decode reads + as a space" (-> assert-eq (url-decode "a+b%2Bc%2F%C3%A9") "a b+c/é")
test "percent-encode keeps only unreserved chars" (-> assert-eq (percent-encode "a b+c/é~-._") "a%20b%2Bc%2F%C3%A9~-._")
test "percent-encode round-trips through a path segment" (-> assert-eq (url-decode (percent-encode "x y")) "x y")
test "url-encode refuses an unpaired surrogate" (-> assert-throws (-> url-encode (from-char-code 55296)))
test "percent-encode refuses one too" (-> assert-throws (-> percent-encode (from-char-code 56320)))
test "url-decode refuses escapes that aren't UTF-8" (-> assert-throws (-> url-decode "%FF"))
test "url-decode refuses an overlong /" (-> assert-throws (-> url-decode "%C0%AF"))
test "url-decode refuses an encoded surrogate" (-> assert-throws (-> url-decode "%ED%A0%80"))
test "url-decode refuses a stray %" (-> assert-throws (-> url-decode "100%"))
