mod std.time

;; Time effect module.
;;
;; The builtins now-ms and sleep perform this effect's time-now and
;; time-sleep. Under a handler with the clause, the handler answers; with
;; none, they read the real clock and really wait.
;;
;; Usage:
;;   use std.time :open
;;
;;   fn bench :: Fn Int ::: Time
;;     => thunk
;;     start := time-now
;;     thunk ()
;;     (time-now) - start
;;
;;   with default-time
;;     bench (-> time-sleep 100)
;;
;;   ;; Mock in tests:
;;   handler fixed-clock :: Time
;;     time-now        => resume 1700000000000
;;     time-sleep ms   => resume ()
;;
;;   with fixed-clock
;;     bench (-> time-sleep 100)   ;; => 0
;;     now-ms ()                   ;; => 1700000000000
;;
;; A handler may leave a clause out: that op then goes on to the next
;; handler out, or to the real clock.

pub effect Time
  time-now :: Int
  time-sleep :: Int -> ()

pub handler default-time :: Time ::: Time
  time-now =>
    resume (now-ms ())
  time-sleep ms =>
    sleep ms
    resume ()
