mod std.math

;; Math utilities — re-exports math builtins plus derived combinators.

;; Re-export builtins
pub sqrt := sqrt
pub floor := floor
pub ceil := ceil
pub round := round
pub sin := sin
pub cos := cos
pub tan := tan
pub log := log
pub exp := exp
pub pow := pow
pub abs := abs
pub min := min
pub max := max
;; Integer division and remainder. Named `quo`/`rem` rather than
;; `div`/`mod`: `mod` is the module-decl keyword, so the old `mod`
;; builtin could never be written down — `mod 7 3` didn't parse, and
;; the only ways to a remainder were the `%` operator or JVM interop.
;; Re-exported here so a qualified `math.quo` still resolves when a
;; user-level fn or seed shadows the name at the top level (e.g.
;; vrata.html's element builder shadows `div`).
pub quo := quo
pub rem := rem
pub pi := pi
pub e := e
pub random-int := random-int
pub random-float := random-float

;; Derived utilities
pub fn clamp :: _ _ _ _
  (lo hi x -> min hi (max lo x))

pub fn lerp :: _ _ _ _
  (a b t -> a + (b - a) * t)

pub fn square :: _ _
  (x -> x * x)

pub fn cube :: _ _
  (x -> x * x * x)

pub fn sign :: _ Int
  => x
  if (x > 0) 1 else (if (x < 0) (0 - 1) else 0)

pub fn even? :: Int Bool
  (n -> n % 2 == 0)

pub fn odd? :: Int Bool
  (n -> n % 2 /= 0)

pub fn gcd :: Int Int Int
  => a b
  if (b == 0) (abs a) else (gcd b (a % b))

pub fn lcm :: Int Int Int
  (a b -> quo (abs (a * b)) (gcd a b))

pub fn sum-of :: Vec _
  (vec -> /+ vec)

pub fn product-of :: Vec _
  (vec -> /* vec)
