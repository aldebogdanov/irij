mod std.env

;; Env effect module: environment variables and program arguments.
;;
;; Usage:
;;   use std.env :open
;;
;;   fn load-config :: Map ::: Env
;;     _ =>
;;       port := env-var "PORT" "8080"
;;       host := env-var "HOST" "localhost"
;;       {port= port host= host args= (env-args ())}
;;
;;   with default-env
;;     load-config ()
;;
;;   ;; Mock in tests:
;;   handler mock-env :: Env
;;     env-var name default => resume "test-value"
;;     env-args ()          => resume #["--port" "9090"]
;;
;;   with mock-env
;;     load-config ()

pub effect Env
  env-var :: Str Str -> Str
  env-args :: Vec                  ;; the arguments after the program: `irij app.irj a b` → #["a" "b"]

pub handler default-env :: Env ::: Env
  env-var name default =>
    resume (env name default)
  env-args () =>
    resume (program-args ())
