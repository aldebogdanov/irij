mod std.datastar

use std.serve {Serve}

;; Datastar SDK for Irij
;; Server-side helpers for the Datastar hypermedia framework.
;; Datastar uses Server-Sent Events (SSE) with two event types:
;;   datastar-patch-elements — morph HTML into the DOM
;;   datastar-patch-signals  — merge JSON into reactive signals

;; ── SSE lifecycle ───────────────────────────────────────────────────

pub fn ds-sse :: Map _ ::: Serve
  (request -> sse-response request)

pub fn ds-done :: _ () ::: Serve
  (sse -> sse-close sse)

pub fn ds-closed? :: _ Bool ::: Serve
  (sse -> sse-closed? sse)

;; ── Datastar events ─────────────────────────────────────────────────
;;
;; Datastar reads an event's data line by line, each line `key value`.
;; A payload line break would let the text after it be read as a key of
;; its own (`selector #x`, `mode remove`), so every line of a payload
;; gets the key (`ds-lines`) and the browser rejoins them; a selector or
;; mode must be one line, or is refused. HTML-escaping user text doesn't
;; cover this: it leaves line breaks alone.

pub fn ds-patch :: _ Str Str () ::: Serve
  (sse selector html -> ds-patch-mode sse selector "outer" html)

pub fn ds-patch-mode :: _ Str Str Str () ::: Serve
  (sse selector mode html -> sse-send sse "datastar-patch-elements" ("selector " ++ (ds-one-line "selector" selector) ++ "\nmode " ++ (ds-one-line "mode" mode) ++ "\n" ++ (ds-lines "elements" html)))

pub fn ds-signals :: _ Str () ::: Serve
  (sse json -> sse-send sse "datastar-patch-signals" (ds-lines "signals" json))

pub fn ds-script :: _ Str () ::: Serve
  (sse js -> sse-send sse "datastar-patch-elements" ("mode append\nselector body\n" ++ (ds-lines "elements" ("<script data-ds-autoremove>" ++ js ++ "</script>"))))

;; Every line of `text` as a `key line` data line. CR, LF and CRLF all
;; end a line for the browser, so all three split here.
fn ds-lines :: Str Str Str
  (key text -> join "\n" ((split (replace (replace text "\r\n" "\n") "\r" "\n") "\n") |> @ (line -> key ++ " " ++ line)))

fn ds-one-line :: Str Str Str
  => what s
  if ((index-of s "\n") >= 0) || ((index-of s "\r") >= 0)
    error ("datastar: the " ++ what ++ " must be one line")
  else
    s

;; ── Signal reading ──────────────────────────────────────────────────

fn ds-is-get
  (request -> request.method == "GET")

pub fn ds-read-signals :: Map _
  => request
  if (ds-is-get request) (ds-query-signals request) else (json-parse request.body)

;; A GET carries the signals as JSON in the `datastar` query parameter,
;; which `request.params` holds decoded; no signals reads as `{}`.
fn ds-query-signals
  => request
  raw := get "datastar" request.params
  if (raw == ())
    {}
  else
    match (try (-> json-parse raw))
      Ok v => v
      Err _ => {}
