{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ],
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
