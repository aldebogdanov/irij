;; basics.irj — bindings, functions, pattern matching, data types

;; ── Immutable bindings ──────────────────────────────────────────────────

x := 42
greeting := "Hello"
println (greeting ++ ", the answer is " ++ (to-str x))

;; ── Numbers ─────────────────────────────────────────────────────────────

println (2/3 + 1/3)      ;; 1        — Rational, exact
println 1.5e3            ;; 1500.0   — Float, with an exponent
println (1e-3 * 2)       ;; 0.002
println (2 ** 70)        ;; 1180591620717411303424 — Int never overflows

;; ── Functions (lambda body form) ─────────────────────────────────────────

fn square
  (n -> n * n)

fn add
  (a b -> a + b)

println (square 7)       ;; 49
println (add 3 4)        ;; 7

;; ── Recursive function (match-arms body form) ────────────────────────────

fn fact
  0 => 1
  n => n * fact (n - 1)

println (fact 10)        ;; 3628800

;; ── Pattern matching ─────────────────────────────────────────────────────

fn describe
  0    => "zero"
  1    => "one"
  n | (n < 0) => "negative"
  _    => "something else"

println (describe 0)     ;; zero
println (describe (-5))   ;; negative
println (describe 99)    ;; something else

;; ── Match as expression (bind result) ────────────────────────────────────

label := match 75
  s | s >= 90 => "excellent"
  s | s >= 70 => "good"
  _           => "needs-work"
println label    ;; good

;; ── cond and case: multi-way choice without else-if chains ──────────────

fn temperature-word
  => degrees
  cond
    degrees < 0 => "freezing"
    degrees < 15 => "cold"
    degrees < 25 => "mild"
    _ => "hot"

println (temperature-word 18)   ;; mild

fn command
  => cmd
  case cmd
    "run" => "running"
    "q" "quit" => "bye"         ;; either value
    _ => "unknown command"

println (command "quit")        ;; bye

;; ── Data types (sum types) ────────────────────────────────────────────────

spec Shape
  Circle Float
  Rect   Float Float

fn area
  Circle r   => pi * r * r
  Rect w h   => w * h

println (area (Circle 3.0))   ;; ~28.274333882308138
println (area (Rect 4.0 5.0)) ;; 20.0

;; ── Product type (record) ────────────────────────────────────────────────

spec Point
  x :: Float
  y :: Float

p := Point 3.0 4.0
println p          ;; Point {x= 3.0 y= 4.0}
println p.x        ;; 3.0

{x= px y= py} := p

;; A Str prints raw on its own, quoted inside anything else — so the
;; two elements of #["a b" "c"] can't look like three. `inspect` gives
;; the quoted form for any value.
println "a b"                  ;; a b
println #["a b" "c"]           ;; #["a b" "c"]
println {name= "Ada"}          ;; {name= "Ada"}
println (inspect "a b")        ;; "a b"
println ("x=" ++ (to-str px) ++ " y=" ++ (to-str py))

;; ── Apply-to-rest (~) ────────────────────────────────────────────────────
;;
;; The ~ operator has the lowest precedence and is right-associative.
;; f ~ rest  ≡  f (rest)   — eliminates parens around the argument.

println ~ "The answer is " ++ to-str x   ;; "The answer is 42"
println ~ square 7                       ;; 49
println ~ area (Circle 3.0)              ;; ~28.27...

;; Right-associative chaining:  f ~ g ~ expr  ≡  f (g (expr))
println ~ to-str ~ 2 + 3                 ;; "5"

;; ── Pipeline ─────────────────────────────────────────────────────────────

result := 5 |> square |> (n -> n + 1)
println result     ;; 26
